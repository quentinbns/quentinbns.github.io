@article{Tom_etal_2026,
title = {Event-based serverless environmental modeling on the cloud: A pedagogical guide and river case study},
journal = {Environmental Modelling & Software},
volume = {196},
pages = {106753},
year = {2026},
issn = {1364-8152},
doi = {https://doi.org/10.1016/j.envsoft.2025.106753},
url = {https://www.sciencedirect.com/science/article/pii/S1364815225004372},
author = {Manu Tom and Cédric H. David and Kevin M. Marlis and Paul A. Zimdars and Quentin Bonassies and Jeffrey Wade and Arnaud Cerbelaud and Matthew Bonnema and Tamlin Pavelsky and Thomas Huang},
keywords = {Cloud computing, Amazon web services, Lambda, Docker containerization, River discharge},
abstract = {Cloud storage of satellite Earth observations motivates moving environmental models closer to the data, while raising concerns about cost and maintainability. We here present a model-agnostic, serverless cloud approach for event-triggered computations that avoids server management on the user-end and leverages containerization for seamless local testing and deployment. Built on Amazon Web Services in proximity to NASA data, our scaffolding uses Lambda and Docker to run models in response to events. We provide a pedagogically structured guide with step-by-step examples for implementing environmental models with minimal infrastructure overhead. A case study of river routing in the Mississippi River Basin demonstrates the approach, simulating 35 years of river discharge. This scaffolding offers a scalable blueprint for deploying environmental models on Amazon Web Services in a data-proximate, serverless, and event-driven fashion.}
}