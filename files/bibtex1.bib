@article{nguyen2022extent,
  author   = {Nguyen, Thanh Huy and Ricci, Sophie and Fatras, Christophe and Piacentini, Andrea and Delmotte, Anthéa and Lavergne, Emeric and Kettig, Peter},
  journal  = {IEEE Transactions on Geoscience and Remote Sensing},
  title    = {Improvement of Flood Extent Representation With Remote Sensing Data and Data Assimilation},
  year     = {2022},
  volume   = {60},
  number   = {},
  pages    = {1-22},
  keywords = {Data models;Hydrodynamics;Radar polarimetry;Rivers;Predictive models;Floods;Hydraulic systems;Data assimilation (DA);ensemble Kalman filter (EnKF);flooding;Garonne;hydraulic model;hydrology;random forest (RF);Sentinel-1;synthetic aperture radar (SAR);Telemac-Mascaret},
